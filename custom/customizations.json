{
  "schema_version": 3,
  "upstream": {
    "repository": "AIsouler/MyClash",
    "branch": "main",
    "path": "Script/mihomoScript.js"
  },
  "output": "mihomoScript.js",
  "runtime": "custom/runtime.js",
  "additional_services": {
    "AppleTV": {
      "providers": {
        "appletv": {
          "type": "http",
          "format": "mrs",
          "interval": 86400,
          "behavior": "domain",
          "url": "https://raw.githubusercontent.com/appshubcc/bett-rules/meta/geo/geosite/apple-tvplus.mrs",
          "path": "./ruleset/appletv.mrs",
          "path-in-bundle": "geo/geosite/apple-tvplus.mrs"
        }
      },
      "rules": [
        "RULE-SET,appletv,AppleTV"
      ]
    },
    "porn": {
      "providers": {
        "porn": {
          "type": "http",
          "format": "mrs",
          "interval": 86400,
          "behavior": "domain",
          "url": "https://raw.githubusercontent.com/frostmage1250/proxy-rules-converter/main/dist/mihomo/porn.mrs",
          "path": "./ruleset/porn.mrs"
        }
      },
      "rules": [
        "RULE-SET,porn,porn"
      ]
    },
    "Claude": {
      "providers": {
        "claude": {
          "type": "http",
          "format": "yaml",
          "interval": 86400,
          "behavior": "classical",
          "url": "https://raw.githubusercontent.com/frostmage1250/proxy-rules-converter/main/dist/mihomo/claude.yaml",
          "path": "./ruleset/claude.yaml"
        }
      },
      "rules": [
        "RULE-SET,claude,Claude"
      ]
    },
    "Apple Podcasts": {
      "providers": {
        "apple_podcasts": {
          "type": "http",
          "format": "mrs",
          "interval": 86400,
          "behavior": "domain",
          "upstream_asset": "geosite/apple-podcasts.mrs",
          "path": "./ruleset/apple-podcasts.mrs",
          "path-in-bundle": "geo/geosite/apple-podcasts.mrs"
        }
      },
      "rules": [
        "RULE-SET,apple_podcasts,Apple Podcasts"
      ]
    }
  },
  "additional_rule_providers": {
    "mcdn屏蔽": {
      "type": "http",
      "format": "mrs",
      "interval": 86400,
      "behavior": "domain",
      "url": "https://raw.githubusercontent.com/frostmage1250/proxy-rules-converter/main/dist/mihomo/mcdn-block.mrs",
      "path": "./ruleset/mcdn-block.mrs"
    }
  },
  "additional_rules": [
    "RULE-SET,mcdn屏蔽,REJECT"
  ],
  "rule_order_overrides": {
    "AppleTV": {
      "before_provider": "apple_cn"
    },
    "Apple Podcasts": {
      "before_provider": "apple_cn"
    },
    "Claude": {
      "before": "AI"
    },
    "porn": {
      "after": "EHentai"
    }
  },
  "option_defaults": {
    "自动选择": false,
    "负载均衡": false,
    "生成地区自动选择组": false
  },
  "omitted_group_testing_fields": [
    "url",
    "interval",
    "timeout",
    "lazy",
    "max-failed-times",
    "tolerance",
    "expected-status"
  ],
  "dns_overrides": {
    "direct-nameserver": [
      "system"
    ],
    "nameserver-policy": {
      "rule-set:cn": [
        "system"
      ]
    }
  },
  "hosts_exclude_suffixes": [
    "mcdn.bilivideo.com",
    "mcdn.bilivideo.cn",
    "edge.mountaintoys.cn",
    "h2.smtcdns.net"
  ],
  "rule_provider_overrides": {
    "geolocation-cn": {
      "type": "http",
      "format": "mrs",
      "interval": 86400,
      "behavior": "domain",
      "url": "https://raw.githubusercontent.com/frostmage1250/proxy-rules-converter/main/dist/mihomo/geolocation-cn.mrs",
      "path": "./ruleset/geolocation-cn-v2fly.mrs"
    }
  }
}
