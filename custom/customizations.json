{
  "schema_version": 2,
  "policy_group_type": "select",
  "preserve_original_proxy_names": true,
  "upstream": {
    "repository": "AIsouler/MyClash",
    "branch": "main",
    "path": "Script/mihomoScript.js"
  },
  "output": "mihomoScript.js",
  "report": "custom/upstream.json",
  "service_provider_url_overrides": {
    "AI": {
      "ai": "https://raw.githubusercontent.com/frostmage1250/proxy-rules-converter/main/dist/mihomo/ai.mrs"
    }
  },
  "base_rule_provider_replacements": {
    "games_cn": {
      "name": "steam_cn",
      "from": "category-games@cn",
      "to": "steam@cn"
    }
  },
  "group_icon_sources": {
    "Proxy": "默认代理",
    "订阅": "手动选择",
    "Direct": "直连",
    "GitHub": "GitHub",
    "AI": "AI",
    "Google": "Google",
    "YouTube": "YouTube",
    "Telegram": "Telegram",
    "PikPak": "PikPak",
    "EHentai": "EHentai",
    "香港": "香港",
    "台湾": "台湾",
    "新加坡": "新加坡",
    "日本": "日本",
    "美国": "美国",
    "其他节点": "其他节点",
    "低倍率节点": "低倍率节点",
    "Final": "漏网之鱼"
  },
  "excluded_services": [
    "FCM",
    "Line",
    "Netflix",
    "Emby",
    "Spotify",
    "Crypto",
    "PayPal",
    "Patreon",
    "AdBlock"
  ],
  "excluded_base_rule_providers": [
    "epicgames"
  ],
  "base_rule_provider_url_overrides": {
    "geolocation-cn": "https://raw.githubusercontent.com/frostmage1250/proxy-rules-converter/main/dist/mihomo/geolocation-cn.mrs"
  },
  "service_routing": {
    "Claude": {
      "target": "Claude",
      "section": "services",
      "relative_to": "AI",
      "offset": -0.1
    },
    "AI": {
      "target": "AI",
      "section": "services"
    },
    "GitHub": {
      "target": "GitHub",
      "section": "services"
    },
    "Telegram": {
      "target": "Telegram",
      "section": "services"
    },
    "AppleTV": {
      "target": "媒体",
      "section": "services",
      "relative_to": "Apple",
      "offset": -0.2
    },
    "Twitch": {
      "target": "媒体",
      "section": "services",
      "relative_to": "YouTube",
      "offset": 0.1
    },
    "Twitter": {
      "target": "媒体",
      "section": "services"
    },
    "TikTok": {
      "target": "媒体",
      "section": "services"
    },
    "YouTube": {
      "target": "YouTube",
      "section": "services"
    },
    "Meta": {
      "target": "媒体",
      "section": "services"
    },
    "Steam": {
      "target": "Proxy",
      "section": "services"
    },
    "PikPak": {
      "target": "PikPak",
      "section": "services"
    },
    "EHentai": {
      "target": "EHentai",
      "section": "services"
    },
    "porn": {
      "target": "porn",
      "section": "services"
    },
    "Google": {
      "target": "Google",
      "section": "services"
    },
    "Apple": {
      "target": "Proxy",
      "section": "services"
    },
    "Microsoft": {
      "target": "Proxy",
      "section": "services"
    },
    "Apple Podcasts": {
      "target": "媒体",
      "section": "services",
      "relative_to": "Apple",
      "offset": -0.1
    }
  },
  "default_service_routing": {
    "target": "Proxy",
    "section": "services",
    "order": 1000
  },
  "base_rule_routing": {
    "geolocation-!cn": {
      "section": "fallback",
      "order": 10
    },
    "cn_ip": {
      "section": "fallback",
      "order": 20
    },
    "private_ip": {
      "section": "fallback",
      "order": 30,
      "no_resolve": true
    }
  },
  "runtime": "custom/runtime.js",
  "source_lock": "custom/sources.lock.json",
  "node_options": {
    "过滤低倍率节点": false,
    "过滤非地区节点": true,
    "FCM": false
  },
  "direct_proxies": [
    {
      "name": "IPv4优先",
      "type": "direct",
      "ip-version": "ipv4-prefer"
    },
    {
      "name": "IPv6优先",
      "type": "direct",
      "ip-version": "ipv6-prefer"
    }
  ],
  "global_overrides": {
    "allow-lan": false,
    "log-level": "warning"
  },
  "omitted_global_fields": [
    "bind-address",
    "ntp",
    "tun.auto-redirect"
  ],
  "dns_overrides": {
    "direct-nameserver": [
      "system"
    ]
  },
  "dns_policy_overrides": {
    "rule-set:cn": [
      "system"
    ]
  },
  "host_overrides": {
    "services.googleapis.cn": "services.googleapis.com"
  },
  "excluded_hosts": [
    "+.mcdn.bilivideo.com",
    "+.mcdn.bilivideo.cn",
    "+.edge.mountaintoys.cn",
    "+.h2.smtcdns.net"
  ],
  "policy_aliases": {
    "直连": "Direct",
    "DIRECT": "Direct",
    "默认代理": "Proxy",
    "漏网之鱼": "Final"
  },
  "excluded_rule_spreads": [],
  "excluded_rules": [
    {
      "type": "DOMAIN",
      "value": "fsend.cn"
    },
    {
      "type": "RULE-SET",
      "value": "epicgames"
    }
  ],
  "additional_services": {
    "AppleTV": {
      "providers": {
        "appletv": {
          "type": "http",
          "format": "mrs",
          "interval": 86400,
          "behavior": "domain",
          "url": "https://raw.githubusercontent.com/appshubcc/bett-rules/meta/geo/geosite/apple-tvplus.mrs",
          "path": "./ruleset/appletv.mrs",
          "path-in-bundle": "geo/geosite/apple-tvplus.mrs"
        }
      },
      "rules": [
        "RULE-SET,appletv,AppleTV"
      ]
    },
    "porn": {
      "providers": {
        "porn": {
          "type": "http",
          "format": "mrs",
          "interval": 86400,
          "behavior": "domain",
          "url": "https://raw.githubusercontent.com/frostmage1250/proxy-rules-converter/main/dist/mihomo/porn.mrs",
          "path": "./ruleset/porn.mrs"
        }
      },
      "rules": [
        "RULE-SET,porn,porn"
      ]
    },
    "Claude": {
      "providers": {
        "claude": {
          "type": "http",
          "format": "yaml",
          "interval": 86400,
          "behavior": "classical",
          "url": "https://raw.githubusercontent.com/frostmage1250/proxy-rules-converter/main/dist/mihomo/claude.yaml",
          "path": "./ruleset/claude.yaml"
        }
      },
      "rules": [
        "RULE-SET,claude,Claude"
      ]
    },
    "Twitch": {
      "providers": {
        "twitch": {
          "type": "http",
          "format": "mrs",
          "interval": 86400,
          "behavior": "domain",
          "url": "https://cdn.jsdmirror.com/gh/appshubcc/bett-rules@meta/geo/geosite/twitch.mrs",
          "path": "./ruleset/twitch.mrs",
          "path-in-bundle": "geo/geosite/twitch.mrs"
        }
      },
      "rules": [
        "RULE-SET,twitch,Twitch"
      ]
    },
    "Apple Podcasts": {
      "providers": {
        "apple_podcasts": {
          "type": "http",
          "format": "mrs",
          "interval": 86400,
          "behavior": "domain",
          "upstream_asset": "geosite/apple-podcasts.mrs",
          "path": "./ruleset/apple-podcasts.mrs",
          "path-in-bundle": "geo/geosite/apple-podcasts.mrs"
        }
      },
      "rules": [
        "RULE-SET,apple_podcasts,Apple Podcasts"
      ]
    }
  },
  "additional_rule_providers": {
    "mcdn屏蔽": {
      "type": "http",
      "format": "mrs",
      "interval": 86400,
      "behavior": "domain",
      "url": "https://raw.githubusercontent.com/frostmage1250/proxy-rules-converter/main/dist/mihomo/mcdn-block.mrs",
      "path": "./ruleset/mcdn-block.mrs"
    }
  },
  "rule_blocks": [
    "upstream_prefix",
    "quic",
    "custom_reject",
    "services",
    "fallback",
    "final"
  ],
  "custom_rules": {
    "custom_reject": [
      "RULE-SET,mcdn屏蔽,REJECT"
    ],
    "final": [
      "MATCH,Final"
    ]
  },
  "client_compatibility": {
    "bettbox_reference": "v1.19.7",
    "memory_limit": 134217728,
    "stack_limit": 524288,
    "timeout_seconds": 10
  },
  "base_rule_spread_routing": {
    "prefixRules": "upstream_prefix",
    "blockForeignQuic": "quic"
  },
  "routing_reference": {
    "repository": "AIsouler/MyClash",
    "path": "Config/mihomoConfig.yaml"
  }
}
